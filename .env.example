# Secret API key from https://resend.com (never commit the real value)
RESEND_API_KEY=

# Inbox that receives the contact form messages (e.g. the coach's Gmail)
CONTACT_TO_EMAIL=

# Verified sender address. Defaults to the line below when empty.
# NOTE: onboarding@resend.dev only delivers to the Resend account owner's
# address until a domain is verified in Resend.
CONTACT_FROM_EMAIL=DinoTeam <onboarding@resend.dev>
